{
  "name": "quran-online",
  "version": "0.1.0",
  "private": true,
  "description": "Quran Online learning platform monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend"
  },
  "engines": {
    "node": ">=20"
  }
}

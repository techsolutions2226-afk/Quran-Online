# Server-side secrets — copy to frontend/.env.local for local development.
# Never commit real secrets.

# Required for login/signup JWT signing
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional JWT lifetime (examples: 1h, 7d, 24h)
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL connection
# Prefer Session Pooler for the Next.js app (serverless-friendly).
# URL-encode special characters in the password (e.g. ( -> %28, ) -> %29).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: direct DB URL for migrations/admin tasks
# DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
